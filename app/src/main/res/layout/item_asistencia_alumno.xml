<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#E8EEF7"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- CÍRCULO DE ESTADO -->
        <TextView
            android:id="@+id/tvEstadoCirculo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_icon_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- NOMBRE Y MATRÍCULA -->
        <LinearLayout
            android:id="@+id/bloqueNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/tvEstadoCirculo"
            app:layout_constraintEnd_toStartOf="@id/bloqueBotones"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvNombreAlumnoLista"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del alumno"
                android:textColor="#1A365D"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvMatriculaAlumnoLista"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Matrícula"
                android:textColor="#6B7A90"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- BLOQUE DE 4 BOTONES DE ESTADO -->
        <LinearLayout
            android:id="@+id/bloqueBotones"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:spacing="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- P — Presente (verde) -->
            <TextView
                android:id="@+id/btnPresente"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="P"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="#BDBDBD"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless" />

            <!-- A — Ausente (rojo) -->
            <TextView
                android:id="@+id/btnAusente"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="A"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="#BDBDBD"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless" />

            <!-- R — Retardo (naranja) -->
            <TextView
                android:id="@+id/btnRetardo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="R"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="#BDBDBD"
                android:layout_marginEnd="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless" />

            <!-- J — Justificado (azul) -->
            <TextView
                android:id="@+id/btnJustificado"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="J"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_icon_circle"
                android:backgroundTint="#BDBDBD"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>