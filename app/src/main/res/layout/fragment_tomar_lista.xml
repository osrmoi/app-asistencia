<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <!-- BARRA SUPERIOR -->
    <LinearLayout
        android:id="@+id/barraTomarLista"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón regresar -->
        <ImageButton
            android:id="@+id/btnRegresarLista"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_arrow"
            android:scaleX="0.7"
            android:scaleY="0.7" />

        <!-- Nombre del grupo -->
        <TextView
            android:id="@+id/tvNombreGrupoLista"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nombre del grupo"
            android:textColor="#1A365D"
            android:textSize="17sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginStart="4dp" />

        <ImageButton
            android:id="@+id/btnExportarLista"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_export"/>

    </LinearLayout>

    <View
        android:id="@+id/dividerBarra"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#DEE3EA"
        app:layout_constraintTop_toBottomOf="@id/barraTomarLista"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvComoTomoLista"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Cómo tomo lista?"
        android:textColor="#1A365D"
        android:textSize="12sp"
        android:textStyle="italic"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/dividerBarra"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- SECCIÓN DE FECHA (DatePicker compacto) -->
    <LinearLayout
        android:id="@+id/cardFecha"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="0dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvComoTomoLista"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Ícono calendario -->
        <ImageView
            android:id="@+id/ivIconoFecha"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_calendar_search"
            android:layout_marginEnd="12dp" />

        <!-- Etiqueta "Fecha:" -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha:"
            android:textColor="#6B7A90"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <!-- Fecha seleccionada (se actualiza desde el Fragment) -->
        <TextView
            android:id="@+id/tvFechaSeleccionada"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="lunes, 12 de mayo de 2025"
            android:textColor="#1A365D"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right" />

    </LinearLayout>

    <!-- FILA: MARCAR TODOS + GUARDAR -->
    <LinearLayout
        android:id="@+id/filaAcciones"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/cardFecha"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Botón "Marcar todos presentes" — ocupa el espacio sobrante -->
        <Button
            android:id="@+id/btnMarcarTodosPresentes"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Todos presentes"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:backgroundTint="#2D6A4F"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:layout_marginEnd="8dp"
            app:cornerRadius="12dp" />

        <!-- Botón "Guardar asistencia" -->
        <Button
            android:id="@+id/btnGuardarAsistencia"
            android:layout_width="130dp"
            android:layout_height="40dp"
            android:text="Guardar lista"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:backgroundTint="#1A365D"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            app:cornerRadius="12dp" />

    </LinearLayout>

    <!-- DIVISOR antes del RecyclerView -->
    <View
        android:id="@+id/dividerLista"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#DEE3EA"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/filaAcciones"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RECYCLER VIEW DE ALUMNOS + ESTADOS -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewAsistencia"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="4dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/dividerLista"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>